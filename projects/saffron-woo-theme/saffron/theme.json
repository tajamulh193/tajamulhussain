{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "720px", "wideSize": "1240px" },
		"color": {
			"defaultPalette": false,
			"palette": [
				{ "slug": "ink", "name": "Ink", "color": "#1F1A17" },
				{ "slug": "paper", "name": "Paper", "color": "#FBF7F1" },
				{ "slug": "cream", "name": "Cream", "color": "#F3EADC" },
				{ "slug": "saffron", "name": "Saffron", "color": "#D9822B" },
				{ "slug": "madder", "name": "Madder", "color": "#9E3B2C" },
				{ "slug": "indigo", "name": "Indigo", "color": "#2E3A59" },
				{ "slug": "stone", "name": "Stone", "color": "#7A7067" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{ "slug": "display", "name": "Display", "fontFamily": "\"Cormorant Garamond\", Georgia, serif" },
				{ "slug": "body", "name": "Body", "fontFamily": "\"Jost\", system-ui, sans-serif" }
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem" },
				{ "slug": "large", "name": "Large", "size": "1.5rem", "fluid": { "min": "1.3rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "2.6rem", "fluid": { "min": "2rem", "max": "2.6rem" } },
				{ "slug": "huge", "name": "Huge", "size": "4.5rem", "fluid": { "min": "2.8rem", "max": "4.5rem" } }
			]
		},
		"spacing": { "units": [ "px", "rem", "%", "vw" ] }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.65" },
		"spacing": { "padding": { "left": "1.5rem", "right": "1.5rem" }, "blockGap": "1.5rem" },
		"elements": {
			"heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "500", "lineHeight": "1.1" } },
			"link": { "color": { "text": "var(--wp--preset--color--madder)" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--ink)", "text": "var(--wp--preset--color--paper)" },
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "0.85rem", "bottom": "0.85rem", "left": "1.6rem", "right": "1.6rem" } },
				":hover": { "color": { "background": "var(--wp--preset--color--madder)" } }
			}
		},
		"blocks": {
			"core/navigation": { "typography": { "fontSize": "var(--wp--preset--font-size--small)", "letterSpacing": "0.08em", "textTransform": "uppercase" } },
			"core/site-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "1.8rem", "fontWeight": "600" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
